{
  "expo": {
    "name": "JapExpress",
    "slug": "japexpress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "japexpress",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.japexpress.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "JapExpress uses your location to find cars near you and to place your pick-up pin.",
        "NSCameraUsageDescription": "Take photos of your car and your ID for verification.",
        "NSPhotoLibraryUsageDescription": "Add photos of your car to your listing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A3C6E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.japexpress.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A3C6E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
